{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebridge.example/contracts/mortgage.schema.json",
  "title": "mortgage",
  "description": "Report dimension: one row per mortgage account. Built by 01_validate_histories from clean mortgage_account rows.",
  "x-grain": "One row per mortgage_id.",
  "x-primary-key": ["mortgage_id"],
  "type": "object",
  "additionalProperties": false,
  "required": ["mortgage_id", "current_cycle_id", "current_account_key", "product_type", "originated_at", "loan_end_at", "identity_status"],
  "properties": {
    "mortgage_id": {"type": "string", "pattern": "^HB-M-[0-9]{6}$"},
    "current_cycle_id": {"type": "string", "pattern": "^C[0-9]{2}$", "description": "Latest deal cycle by deal_start_at."},
    "current_account_key": {"type": "string"},
    "product_type": {"type": "string", "enum": ["fixed_2y", "fixed_3y", "fixed_5y"], "description": "Product type of the current cycle."},
    "originated_at": {"type": "string", "format": "date-time"},
    "loan_end_at": {"type": "string", "format": "date-time"},
    "identity_status": {"type": "string", "enum": ["ok", "conflict"]}
  }
}
