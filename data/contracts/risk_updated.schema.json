{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homebridge.example/contracts/risk_updated.schema.json",
  "title": "risk_updated",
  "description": "Event published after a scoring run completes. INV-5: a failed run publishes no risk_updated event. A publication retry reuses the same event_id. Written by the Models and evaluation work package. Read by the Dashboard and action work package.",
  "x-grain": "One event per mortgage_id + cycle_id + run_id.",
  "x-primary-key": ["event_id"],
  "x-owner": "Models and evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "mortgage_id", "cycle_id", "run_id", "snapshot_id", "model_version", "cluster_model_version", "segment_id", "scored_at", "cutoff_at", "target", "score", "evidence_ids"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "description": "Stable across publication retries."},
    "event_type": {"const": "risk_updated"},
    "schema_version": {"const": "1.0"},
    "mortgage_id": {"type": "string", "pattern": "^HB-M-[0-9]{6}$"},
    "cycle_id": {"type": "string", "pattern": "^C[0-9]{2}$"},
    "run_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^SNP-[0-9a-f]{16}$"},
    "model_version": {"type": "string", "minLength": 1},
    "cluster_model_version": {"type": "string", "minLength": 1},
    "segment_id": {"type": "string", "minLength": 1},
    "scored_at": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "target": {"const": "confirmed_external_refinancing"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
