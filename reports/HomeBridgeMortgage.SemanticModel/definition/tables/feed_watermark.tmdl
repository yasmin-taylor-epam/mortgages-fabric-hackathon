/// Feed freshness per dataset. Drives the stale-feed flag (T03).
table feed_watermark

	column dataset
		dataType: string
		summarizeBy: none
		sourceColumn: dataset

	column checked_at
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		summarizeBy: none
		sourceColumn: checked_at

	column max_ingested_at
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		summarizeBy: none
		sourceColumn: max_ingested_at

	column max_event_at
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		summarizeBy: none
		sourceColumn: max_event_at

	column row_count
		dataType: int64
		summarizeBy: none
		sourceColumn: row_count

	column stale_threshold_hours
		dataType: double
		formatString: 0.000
		summarizeBy: none
		sourceColumn: stale_threshold_hours

	column is_stale
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_stale

	partition feed_watermark = entity
		mode: directLake
		source
			entityName: feed_watermark
			schemaName: dbo
			expressionSource: DatabaseQuery
